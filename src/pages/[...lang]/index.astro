---
import Base from '../../layouts/Base.astro';
import HeroA from '../../components/HeroA.astro';
import What from '../../components/What.astro';
import Works from '../../components/Works.astro';
import Contact from '../../components/Contact.astro';
import { langPaths, type Lang } from '../../data/profile';

export const getStaticPaths = langPaths;
const lang: Lang = Astro.params.lang === 'ru' ? 'ru' : 'en';
---

<Base lang={lang}>
  <HeroA lang={lang} />
  <What lang={lang} />
  <Works lang={lang} />
  <Contact lang={lang} />
</Base>
