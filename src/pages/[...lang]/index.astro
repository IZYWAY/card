---
/**
 * ВРЕМЕННАЯ страница выбора: две ссылки на варианты первого экрана.
 * После выбора здесь будет сам сайт.
 */
import Base from '../../layouts/Base.astro';
import { langPaths, localized } from '../../lib/paths';
import { ui } from '../../data/ui';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
const t = ui[lang];
const options = [
  { key: 'A', href: localized(lang, '/a/'), title: t.optionA, desc: t.optionADesc },
  { key: 'B', href: localized(lang, '/b/'), title: t.optionB, desc: t.optionBDesc },
];
---

<Base lang={lang} page="/" title={t.pickerTitle}>
  <main class="picker">
    <h1>{t.pickerTitle}</h1>
    <p class="lead">{t.pickerLead}</p>
    <ul>
      {
        options.map((o) => (
          <li>
            <a href={o.href}>
              <span class={`thumb thumb-${o.key.toLowerCase()}`} aria-hidden="true">
                <span>{o.key === 'A' ? '' : 'Aa'}</span>
              </span>
              <span class="body">
                <span class="key">{o.key}</span>
                <strong>{o.title}</strong>
                <span class="desc">{o.desc}</span>
                <span class="open">{t.open}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="draft">{t.draft}</p>
  </main>
</Base>

<style>
  .picker {
    max-width: 760px;
    margin-inline: auto;
    padding: clamp(16px, 5vh, 56px) var(--gutter) 40px;
  }
  h1 {
    font-family: var(--display);
    font-size: clamp(26px, 6vw, 44px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .lead {
    margin-top: 14px;
    max-width: 34em;
    color: #2b2c3a;
  }
  ul {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  a {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 18px;
    align-items: center;
    padding: 16px;
    border-radius: 20px;
    background: #f4f5f8;
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 6;
    border-radius: 12px;
    background: var(--pearl);
    overflow: hidden;
  }
  .thumb-a span {
    width: 58%;
    aspect-ratio: 5 / 7;
    border-radius: 7px;
    background:
      radial-gradient(circle at 78% 42%, var(--foil-2) 0 14%, var(--foil-1) 15% 22%, var(--foil-3) 23% 30%, transparent 31%),
      var(--card);
    transform: rotate(-8deg);
    box-shadow: 0 8px 14px rgba(20, 19, 43, 0.3);
  }
  .thumb-b span {
    font-family: var(--display);
    font-size: 40px;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--ink);
    text-shadow:
      2px 2px 0 var(--foil-1),
      4px 4px 0 var(--foil-2),
      6px 6px 0 var(--foil-3);
  }
  .body {
    display: grid;
    gap: 4px;
  }
  .key {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  strong {
    font-family: var(--display);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
  }
  .desc {
    font-size: 15px;
    color: #2b2c3a;
  }
  .open {
    margin-top: 6px;
    font-weight: 600;
    color: var(--accent);
  }
  .draft {
    margin-top: 24px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 420px) {
    a {
      grid-template-columns: 76px 1fr;
      gap: 14px;
    }
    .thumb-b span {
      font-size: 30px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
