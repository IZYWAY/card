---
import Base from '../../layouts/Base.astro';
import HeroB from '../../components/HeroB.astro';
import { langPaths, type Lang } from '../../data/profile';

export const getStaticPaths = langPaths;
const lang: Lang = Astro.params.lang === 'ru' ? 'ru' : 'en';
---

<Base lang={lang} path="b">
  <HeroB lang={lang} />
</Base>
