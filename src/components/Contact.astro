---
import Glitch from './Glitch.astro';
import { copy, profile, asset, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<section class="contact" id="contact">
  <div class="contact__inner">
    <h2 class="contact__title reveal" aria-label={t.contactTitle.join(' ')}>
      {t.contactTitle.map((word) => <span><Glitch text={word} /></span>)}
    </h2>
    <p class="contact__lead reveal">{t.contactLead}</p>

    <div class="contact__links reveal">
      <a class="btn btn--primary" href={profile.telegram.url} target="_blank" rel="noopener">
        Telegram · {profile.telegram.handle}
      </a>
      <a class="btn btn--light" href={profile.instagram.url} target="_blank" rel="noopener">
        {t.instagram} · {profile.instagram.handle}
      </a>
      <a class="btn btn--light" href={asset(profile.vcf)} download>{t.save}</a>
    </div>

    <p class="contact__foot mono">{t.first} {t.last} · {profile.siteLabel}</p>
  </div>
</section>

<style>
  .contact {
    margin-top: 72px;
    background: var(--ink);
    color: var(--on-ink);
    border-radius: 24px 24px 0 0;
  }

  .contact__inner {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 56px var(--gutter) max(32px, env(safe-area-inset-bottom));
  }

  .contact__title {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--display);
    font-weight: 640;
    font-size: clamp(40px, 13.5vw, 132px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .contact__lead {
    margin: 20px 0 28px;
    max-width: 30ch;
    font-size: clamp(17px, 4.6vw, 20px);
    color: var(--on-ink-soft);
  }

  .contact__links {
    display: grid;
    gap: 10px;
    max-width: 420px;
  }

  .contact__links .btn {
    flex: none;
  }

  /* На чёрном кнопки инвертированы: главная белая, остальные с белой рамкой. */
  .contact .btn--primary {
    background: var(--on-ink);
    border-color: var(--on-ink);
    color: var(--ink);
  }

  .btn--light {
    border-color: rgba(255, 255, 255, 0.6);
    color: var(--on-ink);
  }

  @media (hover: hover) {
    .contact .btn--primary:hover {
      background: var(--ink);
      color: var(--on-ink);
    }

    .btn--light:hover {
      background: var(--on-ink);
      border-color: var(--on-ink);
      color: var(--ink);
    }
  }

  .contact__foot {
    margin: 56px 0 0;
    font-size: 10px;
    color: #8c8c8c;
    text-transform: none;
    letter-spacing: 0.03em;
  }
</style>
