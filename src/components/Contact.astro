---
import { copy, profile, asset, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<section class="contact" id="contact">
  <div class="contact__inner">
    <h2 class="contact__title reveal">
      {t.contactTitle.map((word) => <span>{word}</span>)}
    </h2>
    <p class="contact__lead reveal">{t.contactLead}</p>

    <div class="contact__links reveal">
      <a class="btn btn--primary" href={profile.telegram.url} target="_blank" rel="noopener">
        Telegram · {profile.telegram.handle}
      </a>
      <a class="btn btn--light" href={profile.instagram.url} target="_blank" rel="noopener">
        {t.instagram} · {profile.instagram.handle}
      </a>
      <a class="btn btn--light" href={asset(profile.vcf)} download>{t.save}</a>
    </div>

    <p class="contact__foot mono">{t.first} {t.last} · {profile.siteLabel}</p>
  </div>
</section>

<style>
  .contact {
    margin-top: 72px;
    background: var(--card);
    color: #f3f2ff;
    border-radius: 28px 28px 0 0;
  }

  .contact__inner {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 56px var(--gutter) max(32px, env(safe-area-inset-bottom));
  }

  .contact__title {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 11.6vw, 120px);
    line-height: 1.14;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: transparent;
    background: linear-gradient(115deg, var(--foil-1), var(--foil-2) 45%, var(--foil-3) 90%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .contact__lead {
    margin: 20px 0 28px;
    max-width: 30ch;
    font-size: clamp(17px, 4.6vw, 20px);
    color: #d9d8f4;
  }

  .contact__links {
    display: grid;
    gap: 10px;
    max-width: 420px;
  }

  .contact__links .btn {
    flex: none;
  }

  .btn--light {
    border-color: rgba(255, 255, 255, 0.55);
    color: #fff;
  }

  @media (hover: hover) {
    .btn--light:hover {
      background: #fff;
      border-color: #fff;
      color: var(--card);
    }
  }

  .contact__foot {
    margin: 56px 0 0;
    font-size: 10px;
    color: #8f8dbd;
    text-transform: none;
    letter-spacing: 0.03em;
  }
</style>
