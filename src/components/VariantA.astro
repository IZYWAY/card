---
/**
 * Вариант А: карточка-бейдж с голографической фольгой.
 * Наклоняется за гироскопом или курсором, по нажатию переворачивается,
 * на обороте — QR-код (собирается при сборке сайта).
 */
import Actions from './Actions.astro';
import { profile, initials, siteLabel, type Lang } from '../data/profile';
import { ui } from '../data/ui';
import { qrPath } from '../lib/qr';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const name = profile.name[lang];
const words = name.split(/\s+/);
const longest = Math.max(...words.map((w) => w.length));
// Длинная фамилия не должна вылезать за край карточки.
const nameScale = Math.min(1, 8 / longest).toFixed(3);
const qr = qrPath(profile.siteUrl);
---

<main class="a">
  <div class="stage">
    <div class="scene" data-scene>
      <div class="shadow" aria-hidden="true"></div>
      <button class="card" type="button" data-card aria-pressed="false" aria-label={t.flipToBack}
        data-label-front={t.flipToBack} data-label-back={t.flipToFront}>
        <span class="tilt">
          <span class="flip">
            <!-- Лицевая сторона -->
            <span class="face front" data-front>
              <span class="foil-edge"></span>
              <span class="slot"></span>
              <span class="role mono">{profile.role[lang].map((line) => <span>{line}</span>)}</span>
              <span class="coin">
                <span class="coin-foil"></span>
                <span class="coin-text">{initials(lang)}</span>
              </span>
              <span class="card-name" style={`--scale:${nameScale}`}>
                {words.map((w) => <span>{w}</span>)}
              </span>
              <span class="rule"></span>
              <span class="foot mono">
                <span>@{profile.telegram}</span>
                <span class="turn">
                  {t.flip}
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 8a5.5 5.5 0 1 1-1.7-3.97M13.5 2v2.8h-2.8"/></svg>
                </span>
              </span>
              <span class="sheen"></span>
            </span>

            <!-- Оборот -->
            <span class="face back" data-back aria-hidden="true">
              <span class="foil-edge"></span>
              <span class="slot"></span>
              <span class="back-top mono">{t.scan}</span>
              <span class="qr">
                <svg viewBox={`0 0 ${qr.size} ${qr.size}`} role="img" aria-label={t.qrAlt} shape-rendering="crispEdges">
                  <path d={qr.d} fill="currentColor"></path>
                </svg>
              </span>
              <span class="back-url mono">{siteLabel}</span>
              <span class="rule"></span>
              <span class="foot mono">
                <span>{name}</span>
                <span>@{profile.telegram}</span>
              </span>
              <span class="sheen"></span>
            </span>
          </span>
        </span>
      </button>
    </div>
    <p class="hint mono">
      <span>{t.flipHint}</span>
      <button type="button" class="gyro" data-gyro hidden>{t.enableTilt}</button>
    </p>
  </div>

  <div class="who">
    <h1>{name}</h1>
    <p class="tagline">{profile.tagline[lang]}</p>
    <Actions lang={lang} />
  </div>
</main>

<script>
  import { startMotion, bindGyroButton } from '../scripts/motion';

  const scene = document.querySelector<HTMLElement>('[data-scene]')!;
  const card = scene.querySelector<HTMLButtonElement>('[data-card]')!;
  const front = scene.querySelector<HTMLElement>('[data-front]')!;
  const back = scene.querySelector<HTMLElement>('[data-back]')!;
  const gyroButton = document.querySelector<HTMLButtonElement>('[data-gyro]')!;

  // Наклон: числа уходят в CSS-переменные, всю картинку рисует CSS.
  const motion = startMotion(
    scene,
    (x, y) => {
      scene.style.setProperty('--x', x.toFixed(3));
      scene.style.setProperty('--y', y.toFixed(3));
    },
    (s) => [Math.sin(s * 0.8) * 0.55, Math.sin(s * 0.55 + 1) * 0.35],
  );

  // Переворот по нажатию.
  card.addEventListener('click', () => {
    const flipped = scene.classList.toggle('is-flipped');
    card.setAttribute('aria-pressed', String(flipped));
    card.setAttribute('aria-label', flipped ? card.dataset.labelBack! : card.dataset.labelFront!);
    front.toggleAttribute('aria-hidden', flipped);
    if (flipped) front.setAttribute('aria-hidden', 'true');
    back.toggleAttribute('aria-hidden', !flipped);
    if (!flipped) back.setAttribute('aria-hidden', 'true');
  });

  // iPhone: гироскоп только по согласию человека. Пока не разрешили — карточка покачивается сама.
  bindGyroButton(gyroButton, motion);
</script>

<style>
  .a {
    --avail: calc(100svh - var(--bar));
    /* Ширина карточки: чтобы на телефоне карточка, имя и кнопки помещались в один экран. */
    --card-w: clamp(196px, min(66vw, calc((var(--avail) - 300px) * 0.714)), 300px);
    display: grid;
    align-content: start;
    gap: 14px;
    min-height: var(--avail);
    padding: 4px var(--gutter) max(18px, env(safe-area-inset-bottom));
  }

  .mono {
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stage {
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  /* ---------- Сцена и карточка ---------- */
  .scene {
    --x: 0;
    --y: 0;
    position: relative;
    width: var(--card-w);
    aspect-ratio: 5 / 7;
    /* Все размеры внутри карточки считаются от её ширины. */
    font-size: calc(var(--card-w) / 20);
    perspective: 55em;
  }

  .card {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: #f3f2ff;
    font: inherit;
    text-align: left;
    cursor: pointer;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
    transform-style: preserve-3d;
  }
  .card:focus-visible {
    outline-offset: 8px;
    border-radius: 1.4em;
  }

  .tilt,
  .flip {
    position: absolute;
    inset: 0;
    display: block;
    transform-style: preserve-3d;
  }
  .tilt {
    transform: rotateX(calc(var(--y) * var(--amp, 1) * -13deg)) rotateY(calc(var(--x) * var(--amp, 1) * 16deg));
    will-change: transform;
  }
  /* Оборотом карточку показывают под камеру: там она почти не качается, чтобы QR читался сразу. */
  .is-flipped .tilt {
    --amp: 0.3;
  }
  .flip {
    transition: transform 0.9s cubic-bezier(0.2, 0.9, 0.25, 1.08);
  }
  .is-flipped .flip {
    transform: rotateY(180deg);
  }

  .face {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: 1.3em;
    background:
      radial-gradient(120% 70% at 12% 0%, #2a2857 0%, rgba(42, 40, 87, 0) 60%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.022) 0 1px, transparent 1px 5px),
      var(--card);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    /* Тонкая «толщина» пластика: ребро видно с той стороны, куда наклонена карточка. */
    box-shadow:
      calc(var(--x) * -0.14em) calc(var(--y) * -0.12em) 0 0 #34326a,
      calc(var(--x) * -0.24em) calc(var(--y) * -0.2em) 0 0 #1c1b3c;
  }
  .back {
    transform: rotateY(180deg);
    box-shadow:
      calc(var(--x) * 0.14em) calc(var(--y) * -0.12em) 0 0 #34326a,
      calc(var(--x) * 0.24em) calc(var(--y) * -0.2em) 0 0 #1c1b3c;
  }

  /* Тень под карточкой уезжает в сторону, противоположную наклону. */
  .shadow {
    position: absolute;
    inset: 6% 5% -3%;
    border-radius: 1.6em;
    background: rgba(20, 19, 43, 0.42);
    filter: blur(1.4em);
    transform: translate(calc(var(--x) * -1.1em), calc(1.1em + var(--y) * -0.8em));
    will-change: transform;
  }

  /* Фольга: три цвета, угол и положение зависят от наклона. */
  .foil-edge {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 0.11em;
    background: linear-gradient(
        calc(120deg + var(--x) * 70deg),
        var(--foil-1),
        var(--foil-2),
        var(--foil-3),
        var(--foil-1),
        var(--foil-2)
      )
      border-box;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    opacity: 0.85;
  }

  .slot {
    position: absolute;
    top: 1.05em;
    left: 50%;
    width: 3.6em;
    height: 0.78em;
    margin-left: -1.8em;
    border-radius: 1em;
    background: var(--pearl);
    box-shadow:
      inset 0 0.1em 0.18em rgba(14, 14, 26, 0.55),
      0 0 0 0.08em rgba(255, 255, 255, 0.12);
  }

  .role {
    position: absolute;
    top: 4em;
    left: 2em;
    display: grid;
    gap: 0.4em;
    font-size: 0.74em;
    line-height: 1;
    color: #c9c8ea;
  }

  /* «Монета»-голограмма с инициалами */
  .coin {
    position: absolute;
    top: 5.6em;
    right: -1.8em;
    width: 12.6em;
    height: 12.6em;
    border-radius: 50%;
    overflow: hidden;
    transform: translate(calc(var(--x) * 0.5em), calc(var(--y) * 0.4em));
    box-shadow:
      0 0.5em 1.4em rgba(0, 0, 0, 0.45),
      inset 0 0 0 0.07em rgba(255, 255, 255, 0.55);
  }
  .coin-foil {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(
        circle at calc(50% + var(--x) * 42%) calc(50% + var(--y) * 42%),
        rgba(255, 255, 255, 0.95) 0%,
        rgba(255, 255, 255, 0) 38%
      ),
      repeating-radial-gradient(circle at 50% 50%, rgba(20, 19, 43, 0) 0 0.2em, rgba(20, 19, 43, 0.2) 0.2em 0.27em),
      conic-gradient(
        from calc(var(--x) * 150deg + var(--y) * 90deg),
        var(--foil-1),
        var(--foil-2),
        var(--foil-3),
        var(--foil-1),
        var(--foil-2),
        var(--foil-3),
        var(--foil-1)
      );
  }
  .coin-text {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-right: 1.3em;
    font-family: var(--display);
    font-size: 3.5em;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--card);
    opacity: 0.92;
  }

  .card-name {
    --size: calc(2.1 * var(--scale, 1));
    position: absolute;
    left: calc(1.45em / var(--size));
    right: 0;
    bottom: calc(4.5em / var(--size));
    display: grid;
    font-family: var(--display);
    font-size: calc(1em * var(--size));
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    transform: translate(calc(var(--x) * 0.12em), calc(var(--y) * 0.1em));
  }

  .rule {
    position: absolute;
    left: 1.5em;
    right: 1.5em;
    bottom: 3.3em;
    height: 0.09em;
    background: linear-gradient(90deg, var(--foil-1), var(--foil-2), var(--foil-3), var(--foil-1), var(--foil-2));
    background-size: 220% 100%;
    background-position: calc(50% + var(--x) * 50%) 0;
  }

  .foot {
    position: absolute;
    left: 2em;
    right: 2em;
    bottom: 2em;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1em;
    font-size: 0.74em;
    line-height: 1;
    color: #c9c8ea;
    white-space: nowrap;
  }
  .foot > span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .turn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .turn svg {
    width: 1.35em;
    height: 1.35em;
  }

  /* Блик, который проходит по всей карточке при наклоне */
  .sheen {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      112deg,
      transparent 32%,
      rgba(111, 227, 255, 0.2) 43%,
      rgba(255, 122, 217, 0.2) 50%,
      rgba(255, 226, 122, 0.18) 57%,
      transparent 68%
    );
    background-size: 280% 280%;
    background-position: calc(50% + var(--x) * 45%) calc(50% + var(--y) * 45%);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* ---------- Оборот ---------- */
  .back-top {
    position: absolute;
    top: 4.2em;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.74em;
    line-height: 1;
    color: #c9c8ea;
  }
  .qr {
    position: absolute;
    top: 4.6em;
    left: 2.4em;
    right: 2.4em;
    aspect-ratio: 1;
    display: grid;
    padding: 0.15em;
    border-radius: 0.9em;
    background: #f5f6f9;
    color: var(--card);
    /* QR лежит поверх блика: переливы не должны мешать камере его читать. */
    z-index: 1;
  }
  .qr svg {
    width: 100%;
    height: 100%;
  }
  .back-url {
    position: absolute;
    left: 2em;
    right: 2em;
    bottom: 6.6em;
    text-align: center;
    font-size: 0.74em;
    line-height: 1;
    text-transform: none;
    color: #f3f2ff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---------- Подсказка под карточкой ---------- */
  .hint {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4px 12px;
    font-size: 10px;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
  }
  .gyro {
    padding: 6px 10px;
    border: 1px solid rgba(14, 14, 26, 0.3);
    border-radius: 999px;
    background: none;
    color: var(--ink);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  /* ---------- Имя, строка о деле, кнопки ---------- */
  .who {
    display: grid;
    gap: 10px;
    align-content: start;
    width: 100%;
    max-width: 460px;
    margin-inline: auto;
  }
  .who h1 {
    font-family: var(--display);
    font-size: clamp(22px, 6.4vw, 28px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .who .tagline {
    font-size: 16px;
    line-height: 1.4;
    margin-bottom: 4px;
  }

  /* ---------- Компьютер: карточка слева, текст справа ---------- */
  @media (min-width: 900px) {
    .a {
      --card-w: clamp(260px, min(27vw, calc((var(--avail) - 150px) * 0.714)), 380px);
      grid-template-columns: auto minmax(0, 520px);
      justify-content: center;
      align-content: center;
      align-items: center;
      gap: clamp(48px, 7vw, 110px);
      padding-bottom: var(--bar);
    }
    .who {
      gap: 18px;
      max-width: none;
      margin: 0;
    }
    .who h1 {
      font-size: clamp(36px, 3.6vw, 54px);
      line-height: 1.08;
    }
    .who .tagline {
      font-size: 20px;
      max-width: 30em;
      margin-bottom: 10px;
    }
    .hint {
      font-size: 11px;
    }
  }

  /* ---------- Без движения ---------- */
  @media (prefers-reduced-motion: reduce) {
    .flip {
      transition: none;
    }
    .tilt {
      will-change: auto;
    }
  }
</style>
