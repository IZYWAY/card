---
import { telegramUrl, type Lang } from '../data/profile';
import { ui } from '../data/ui';
import { path } from '../lib/paths';

interface Props {
  lang: Lang;
}
const t = ui[Astro.props.lang];
---

<div class="actions">
  <a class="btn btn-primary" href={telegramUrl} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.4 3.3 2.9 10.5c-.9.4-.9 1.6.1 1.9l4.6 1.5 1.8 5.6c.2.7 1.1.9 1.6.4l2.6-2.5 4.6 3.4c.6.4 1.5.1 1.6-.6l3-15.6c.2-.9-.6-1.6-1.4-1.3ZM9.6 14.4l8-6.3-6.2 7.3-.3 3.2-1.5-4.2Z"/></svg>
    {t.telegram}
  </a>
  <a class="btn btn-ghost" href={path('/contact.vcf')} download="contact.vcf">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="8" r="3.6"/><path d="M3.5 19.5c.6-3.4 3.2-5.3 6.5-5.3 1.6 0 3 .4 4.1 1.3M18.5 14v6M15.5 17h6"/></svg>
    {t.save}
  </a>
</div>
