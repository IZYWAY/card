---
import Actions from './Actions.astro';
import { copy, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const rows = [t.first, t.last].map((word) => [...word.toUpperCase()]);
const cols = Math.max(...rows.map((row) => row.length));
---

<section class="heroB">
  <p class="heroB__role mono">{t.role}</p>

  <h1 class="kinetic" aria-label={`${t.first} ${t.last}`} style={`--cols:${cols}`}>
    {
      rows.map((row, r) => (
        <span class="kinetic__row" aria-hidden="true">
          {row.map((ch, i) => (
            <span class="kinetic__cell">
              <span class="kinetic__ch" style={`--i:${i};--r:${r};--x:${(i / (cols - 1)).toFixed(3)}`}>
                {ch}
              </span>
            </span>
          ))}
        </span>
      ))
    }
  </h1>

  <div class="heroB__rule" aria-hidden="true"></div>

  <p class="lead">{t.line}</p>
  <Actions lang={lang} />
</section>

<style>
  @property --p {
    syntax: '<number>';
    inherits: true;
    initial-value: 0.5;
  }

  .heroB {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 22px;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 12px var(--gutter) max(28px, env(safe-area-inset-bottom));
  }

  .heroB__role {
    margin: 0 0 auto;
    padding-top: 28px;
    color: var(--ink-soft);
  }

  .kinetic {
    --cell: calc((min(100vw, 1180px) - var(--gutter) * 2) / var(--cols));
    margin: 0;
    font-family: var(--display);
    font-size: calc(var(--cell) * 1.06);
    line-height: 1;
    font-weight: 900;
    /* Буквы у Unbounded широкие: на узком экране вытягиваем их вверх, чтобы имя занимало экран. */
    transform: scaleY(var(--stretch, 1.9));
    transform-origin: bottom left;
    margin-top: calc(var(--cell) * 2.3 * (var(--stretch, 1.9) - 1));
  }

  .kinetic__row {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    overflow: hidden;
    padding-top: 0.06em;
  }

  /* Имя идёт с естественной шириной букв: в сетке узкие буквы вроде I оставляют дыры. */
  .kinetic__row:first-child {
    display: flex;
    gap: 0.05em;
  }

  .kinetic__cell {
    display: block;
    text-align: center;
  }

  .kinetic__ch {
    display: inline-block;
    font-variation-settings: 'wght' 900;
    animation:
      rise 0.85s cubic-bezier(0.2, 0.9, 0.25, 1) both,
      wave 3.4s ease-in-out infinite;
    animation-delay:
      calc(var(--i) * 55ms + var(--r) * 180ms),
      calc(900ms + var(--i) * 110ms + var(--r) * 240ms);
  }

  /* Когда двигают курсор или наклоняют телефон, волна идёт за ними. */
  .kinetic.is-live .kinetic__ch {
    animation: none;
    font-variation-settings: 'wght'
      calc(900 - 620 * clamp(0, max(var(--p) - var(--x), var(--x) - var(--p)) * 2.4, 1));
    transition: font-variation-settings 0.25s ease-out;
  }

  .heroB__rule {
    height: 6px;
    border-radius: 99px;
    background: linear-gradient(
      90deg,
      var(--foil-1),
      var(--foil-2),
      var(--foil-3),
      var(--foil-1),
      var(--foil-2)
    );
    background-size: 220% 100%;
    background-position: calc(var(--p) * 100%) 0;
    transform-origin: left;
    animation: draw 0.9s 0.7s cubic-bezier(0.2, 0.9, 0.25, 1) both;
  }

  .heroB .lead {
    max-width: 34ch;
  }

  .heroB :global(.actions) {
    justify-content: flex-start;
  }

  @media (min-width: 720px) {
    .kinetic {
      --stretch: 1;
    }
    .heroB {
      gap: 28px;
      padding-bottom: 56px;
    }
    .heroB .lead {
      font-size: 22px;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }

  @keyframes wave {
    0%,
    100% {
      font-variation-settings: 'wght' 900;
    }
    50% {
      font-variation-settings: 'wght' 280;
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.heroB');
  const kinetic = document.querySelector<HTMLElement>('.kinetic');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && kinetic && !reduce) {
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    let idleTimer = 0;
    let baseGamma: number | null = null;

    const setPoint = (p: number) => {
      kinetic.classList.add('is-live');
      hero.style.setProperty('--p', clamp(p).toFixed(3));
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => kinetic.classList.remove('is-live'), 2200);
    };

    window.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      setPoint(event.clientX / window.innerWidth);
    });

    const onOrientation = (event: DeviceOrientationEvent) => {
      if (event.gamma === null) return;
      baseGamma ??= event.gamma;
      const delta = event.gamma - baseGamma;
      if (Math.abs(delta) > 1.5) setPoint(0.5 + delta / 40);
    };

    type OrientationPermission = { requestPermission?: () => Promise<'granted' | 'denied'> };
    const Orientation =
      typeof DeviceOrientationEvent !== 'undefined'
        ? (DeviceOrientationEvent as unknown as OrientationPermission)
        : null;

    if (Orientation && typeof Orientation.requestPermission === 'function') {
      // На iPhone доступ к наклону даётся только после нажатия.
      kinetic.addEventListener(
        'click',
        () => {
          Orientation.requestPermission?.()
            .then((state) => {
              if (state === 'granted') window.addEventListener('deviceorientation', onOrientation, { passive: true });
            })
            .catch(() => {});
        },
        { once: true },
      );
    } else {
      window.addEventListener('deviceorientation', onOrientation, { passive: true });
    }
  }
</script>
