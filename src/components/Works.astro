---
import { copy, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const { meet, chat, desk } = t.works;
---

<section class="section works" id="works">
  <h2 class="section__title reveal">{t.worksTitle}</h2>
  <p class="works__lead reveal">{t.worksLead}</p>

  <div class="works__row">
    <!-- Мини-приложение для знакомств -->
    <article class="work reveal" style="--tone: var(--foil-1)">
      <div class="phone" aria-hidden="true">
        <div class="phone__screen">
          <div class="phone__bar mono">{meet.bar}</div>
          <ul class="people">
            {
              meet.people.map((person) => (
                <li class="people__item">
                  <span class="people__dot" />
                  <span class="people__text">
                    <strong>{person.who}</strong>
                    <span>{person.wants}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <div class="phone__cta">{meet.action}</div>
        </div>
      </div>
      <p class="work__tag mono">{t.conceptTag}</p>
      <h3 class="work__name">{meet.name}</h3>
      <p class="work__line">{meet.line}</p>
    </article>

    <!-- ИИ-ассистент -->
    <article class="work reveal" style="--tone: var(--foil-2)">
      <div class="phone" aria-hidden="true">
        <div class="phone__screen">
          <div class="phone__bar mono">{chat.bar}</div>
          <div class="chat">
            {chat.messages.map((message) => <p class={`chat__msg chat__msg--${message.from}`}>{message.text}</p>)}
          </div>
          <div class="chat__input">{lang === 'ru' ? 'Сообщение' : 'Message'}</div>
        </div>
      </div>
      <p class="work__tag mono">{t.conceptTag}</p>
      <h3 class="work__name">{chat.name}</h3>
      <p class="work__line">{chat.line}</p>
    </article>

    <!-- Рабочая панель -->
    <article class="work reveal" style="--tone: var(--foil-3)">
      <div class="phone" aria-hidden="true">
        <div class="phone__screen">
          <div class="phone__bar mono">{desk.bar}</div>
          <ul class="rows">
            {
              desk.rows.map((row) => (
                <li class="rows__item">
                  <span>{row.what}</span>
                  <span class={`chip chip--${row.tone}`}>{row.status}</span>
                </li>
              ))
            }
          </ul>
          <div class="chart">
            <span class="chart__label mono">{desk.chart}</span>
            <div class="chart__bars">
              {[42, 64, 38, 80, 56, 92, 70].map((h) => <span style={`height:${h}%`} />)}
            </div>
          </div>
        </div>
      </div>
      <p class="work__tag mono">{t.conceptTag}</p>
      <h3 class="work__name">{desk.name}</h3>
      <p class="work__line">{desk.line}</p>
    </article>
  </div>
</section>

<style>
  .works__lead {
    margin: -8px 0 28px;
    max-width: 44ch;
    color: var(--ink-soft);
  }

  /* На телефоне концепты листаются вбок. */
  .works__row {
    display: flex;
    gap: 16px;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .works__row::-webkit-scrollbar {
    display: none;
  }

  .work {
    flex: 0 0 min(78vw, 300px);
    scroll-snap-align: center;
  }

  .phone {
    aspect-ratio: 2 / 3;
    padding: 9px;
    border-radius: 34px;
    background: var(--card);
    box-shadow: 0 18px 30px rgba(20, 19, 43, 0.18);
  }

  .phone__screen {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 16px 12px 14px;
    border-radius: 26px;
    background: #f7f8fa;
    color: var(--ink);
    font-size: 13px;
    line-height: 1.3;
    overflow: hidden;
  }

  .phone__bar {
    padding: 0 2px 10px;
    border-bottom: 1px solid #dfe2e8;
    font-size: 9px;
    color: var(--ink-soft);
  }

  .phone__cta {
    margin-top: auto;
    padding: 12px;
    border-radius: 12px;
    background: var(--card);
    color: #fff;
    font-weight: 600;
    text-align: center;
  }

  /* Знакомства */
  .people {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .people__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid #e3e6eb;
  }

  .people__dot {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--tone);
  }

  .people__text {
    display: grid;
    gap: 2px;
  }

  .people__text span {
    color: var(--ink-soft);
    font-size: 12px;
  }

  /* Чат */
  .chat {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chat__msg {
    max-width: 86%;
    margin: 0;
    padding: 9px 11px;
    border-radius: 14px;
  }

  .chat__msg--them {
    align-self: flex-end;
    background: var(--card);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .chat__msg--ai {
    align-self: flex-start;
    background: var(--tone);
    border-bottom-left-radius: 4px;
  }

  .chat__input {
    margin-top: auto;
    padding: 11px 14px;
    border-radius: 99px;
    background: #fff;
    border: 1px solid #e3e6eb;
    color: #9a9cab;
  }

  /* Панель */
  .rows {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows__item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid #e3e6eb;
  }

  .chip {
    flex: none;
    padding: 3px 8px;
    border-radius: 99px;
    font-size: 11px;
    font-weight: 600;
    background: #e9ebef;
  }

  .chip--new {
    background: var(--tone);
  }

  .chip--work {
    background: var(--card);
    color: #fff;
  }

  .chart {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    min-height: 0;
    margin-top: 4px;
    padding: 10px;
    border-radius: 14px;
    background: var(--card);
  }

  .chart__label {
    font-size: 9px;
    color: #b9b7e6;
  }

  .chart__bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    flex: 1;
    min-height: 40px;
  }

  .chart__bars span {
    flex: 1;
    border-radius: 4px 4px 0 0;
    background: var(--tone);
  }

  .work__tag {
    display: inline-block;
    margin: 20px 0 0;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid var(--ink);
    font-size: 9px;
  }

  .work__name {
    margin: 10px 0 6px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.2;
    text-wrap: balance;
  }

  .work__line {
    margin: 0;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .works__row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
      margin: 0;
      padding: 0;
      overflow: visible;
    }

    .phone {
      max-width: 300px;
    }
  }
</style>
