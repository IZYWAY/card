---
import QRCode from 'qrcode';
// Шрифт бейджа — Geist, как у бейджа Vercel (лицензия OFL).
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import Actions from './Actions.astro';
import { copy, profile, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];

// Тот же QR в виде сетки 0/1 — по ней 3D-бейдж рисует оборот.
const qrModules = QRCode.create(profile.site, { errorCorrectionLevel: 'M' }).modules;
const qrBits = Array.from(qrModules.data, (v) => (v ? '1' : '0')).join('');

const qr = await QRCode.toString(profile.site, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#000000', light: '#0000' },
});

const initials = `${t.first[0]}${t.last[0]}`.toUpperCase();
---

<section class="heroA">
  <!-- Сюда после загрузки страницы встаёт 3D-бейдж на ленте. До этого видна HTML-карточка ниже. -->
  <div class="lanyard" data-lanyard></div>
  <div class="badgeWrap">
    <button
      class="badge"
      type="button"
      aria-pressed="false"
      aria-label={t.flipToQr}
      data-qr={qrBits}
      data-qr-size={qrModules.size}
      data-site={profile.siteLabel}
      data-tag={t.badgeTag}
      data-qr-title={t.qrTitle}
      data-handle={profile.telegram.handle}
    >
      <span class="badge__tilt">
        <span class="badge__flip">
          <!-- Рисунок в духе бейджа Vercel Ship '24: вместо логотипа и слова SHIP — инициалы. -->
          <span class="badge__face badge__front">
            <span class="badge__mark" aria-hidden="true">{initials}</span>
            <span class="badge__big" aria-hidden="true">
              {[...initials].map((letter) => <span>{letter}</span>)}
            </span>
            <span class="badge__name">
              <span>{t.first}</span>
              <span>{t.last}</span>
            </span>
            <span class="badge__role mono">{t.role}</span>
            <span class="badge__wordmark" aria-hidden="true">{initials}<span>{t.badgeTag}</span></span>
          </span>
          <span class="badge__face badge__back">
            <span class="badge__qrtitle mono">{t.qrTitle}</span>
            <span class="badge__qr" set:html={qr} />
            <span class="badge__site mono">
              <span>{profile.siteLabel}</span>
              <span>{profile.telegram.handle}</span>
            </span>
            <span class="badge__wordmark" aria-hidden="true">{initials}<span>{t.badgeTag}</span></span>
          </span>
        </span>
      </span>
    </button>
  </div>

  <p class="heroA__hint mono" data-drag-hint={t.dragHint}>{t.flipHint}</p>
  <h1 class="lead">{t.line}</h1>
  <Actions lang={lang} />
</section>

<style>
  @property --mx {
    syntax: '<number>';
    inherits: true;
    initial-value: 0.5;
  }
  @property --my {
    syntax: '<number>';
    inherits: true;
    initial-value: 0.5;
  }
  @property --rx {
    syntax: '<angle>';
    inherits: true;
    initial-value: 0deg;
  }
  @property --ry {
    syntax: '<angle>';
    inherits: true;
    initial-value: 0deg;
  }

  .heroA {
    position: relative;
    min-height: calc(100svh - 56px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 12px var(--gutter) max(28px, env(safe-area-inset-bottom));
    text-align: center;
  }

  .badgeWrap {
    /* Отступ сверху оставляет место для ленты над бейджем. */
    margin-top: clamp(28px, 9svh, 96px);
    animation: drop 0.9s cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
  }

  /* 3D-бейдж: холст на весь первый экран и выше, под шапку — лента уходит за верхний край.
     Нажатия холст не ловит: их разбирает скрипт, чтобы не мешать кнопкам и прокрутке. */
  .lanyard {
    position: absolute;
    left: 0;
    right: 0;
    top: -72px;
    bottom: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .lanyard :global(canvas) {
    display: block;
  }

  .heroA.is-3d .lanyard {
    opacity: 1;
  }

  /* HTML-карточка остаётся на месте (для клавиатуры и экранного диктора), но не видна. */
  .heroA.is-3d .badge {
    animation: none;
    pointer-events: none;
  }

  .heroA.is-3d .badge__tilt {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  :global(html.is-over-badge) {
    cursor: grab;
  }

  :global(html.is-grabbing),
  :global(html.is-grabbing *) {
    cursor: grabbing !important;
    user-select: none;
  }

  .badge {
    display: block;
    height: min(48svh, 470px);
    max-width: 84vw;
    aspect-ratio: 0.68;
    padding: 0;
    border: 0;
    background: none;
    color: #f3f2ff;
    font: inherit;
    cursor: pointer;
    perspective: 1000px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    animation: sway 8s ease-in-out infinite;
  }

  .badge.is-live {
    animation: none;
  }

  .badge__tilt,
  .badge__flip {
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .badge__tilt {
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    filter: drop-shadow(0 26px 30px rgba(10, 10, 20, 0.3));
  }

  /* Все размеры внутри карточки считаются от её ширины (единицы cqw). */
  .badge__flip {
    container-type: inline-size;
    transition: transform 0.75s cubic-bezier(0.2, 0.85, 0.25, 1);
  }

  .badge[aria-pressed='true'] .badge__flip {
    transform: rotateY(180deg);
  }

  .badge__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    border-radius: 18px;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    text-align: left;
    font-family: 'Geist Variable', 'Helvetica Neue', Arial, sans-serif;
  }

  /* Лицевая сторона: чёрная, огромные инициалы столбиком справа. */
  .badge__front {
    padding: 6.25cqw;
    background: #000;
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .badge__mark {
    font-weight: 700;
    font-size: 5.2cqw;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .badge__big {
    position: absolute;
    top: 7%;
    right: 5%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-weight: 640;
    font-size: 54cqw;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  /* Тонкий «разлом» во второй букве, как в 3D-версии. */
  .badge__big span:last-child {
    clip-path: polygon(0 0, 100% 0, 100% 52%, 0 52%, 0 58%, 100% 58%, 100% 100%, 0 100%);
  }

  .badge__name {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: auto;
    font-weight: 600;
    font-size: 7.4cqw;
    line-height: 1.06;
    letter-spacing: -0.02em;
  }

  .badge__role {
    position: relative;
    margin-top: 3.5cqw;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: max(8px, 2.7cqw);
    letter-spacing: 0.06em;
    color: #d6d6d6;
  }

  .badge__wordmark {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    margin-top: 11cqw;
    font-weight: 600;
    font-size: 4.4cqw;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .badge__wordmark span {
    display: inline-grid;
    place-items: center;
    min-width: 0.86em;
    height: 0.86em;
    padding: 0 0.16em;
    border: 0.065em solid currentColor;
    border-radius: 0.2em;
    font-size: 0.5em;
    letter-spacing: 0;
  }

  /* Оборот: белый, QR-код по центру. */
  .badge__back {
    transform: rotateY(180deg);
    align-items: center;
    padding: 6.25cqw;
    background: #fff;
    color: #000;
    text-align: center;
  }

  .badge__qrtitle {
    margin-top: 17cqw;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-weight: 600;
    font-size: max(9px, 3.4cqw);
    letter-spacing: 0.1em;
  }

  .badge__qr {
    display: block;
    width: 74%;
    margin-top: 6cqw;
  }

  .badge__qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .badge__site {
    display: flex;
    flex-direction: column;
    gap: 1.2cqw;
    margin-top: 6cqw;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: max(9px, 3cqw);
    text-transform: none;
    letter-spacing: 0.02em;
    color: #222;
  }

  .badge__back .badge__wordmark {
    margin-top: auto;
  }

  .heroA__hint {
    margin: 14px 0 0;
    max-width: 34ch;
    text-wrap: balance;
    color: var(--ink-soft);
    font-size: 10px;
  }

  @keyframes sway {
    0%,
    100% {
      --rx: 5deg;
      --ry: -11deg;
      --mx: 0.15;
      --my: 0.25;
    }
    50% {
      --rx: -4deg;
      --ry: 11deg;
      --mx: 0.85;
      --my: 0.75;
    }
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(46px) rotate(-7deg) scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const badge = document.querySelector<HTMLButtonElement>('.badge');

  if (badge) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
    let idleTimer = 0;
    let base: { beta: number; gamma: number } | null = null;
    let gyroOn = false;

    const setTilt = (rx: number, ry: number) => {
      badge.classList.add('is-live');
      badge.style.setProperty('--rx', `${rx.toFixed(2)}deg`);
      badge.style.setProperty('--ry', `${ry.toFixed(2)}deg`);
      badge.style.setProperty('--mx', (0.5 + ry / 28).toFixed(3));
      badge.style.setProperty('--my', (0.5 - rx / 24).toFixed(3));
    };

    // Возврат к плавному покачиванию, когда карточку перестали двигать.
    const scheduleIdle = () => {
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        if (!gyroOn) badge.classList.remove('is-live');
      }, 1800);
    };

    const onOrientation = (event: DeviceOrientationEvent) => {
      if (event.beta === null || event.gamma === null) return;
      gyroOn = true;
      base ??= { beta: event.beta, gamma: event.gamma };
      const ry = clamp((event.gamma - base.gamma) / 2, -14, 14);
      const rx = clamp(-(event.beta - base.beta) / 2.5, -12, 12);
      setTilt(rx, ry);
    };

    const startGyro = () => {
      if (reduce) return;
      window.addEventListener('deviceorientation', onOrientation, { passive: true });
    };

    type OrientationPermission = { requestPermission?: () => Promise<'granted' | 'denied'> };
    const needsPermission =
      typeof DeviceOrientationEvent !== 'undefined' &&
      typeof (DeviceOrientationEvent as unknown as OrientationPermission).requestPermission === 'function';

    if (!needsPermission) startGyro();

    if (!reduce) {
      badge.addEventListener('pointermove', (event) => {
        if (event.pointerType !== 'mouse') return;
        const rect = badge.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        setTilt(clamp(-y * 22, -12, 12), clamp(x * 26, -14, 14));
        scheduleIdle();
      });
      badge.addEventListener('pointerleave', scheduleIdle);
    }

    let asked = false;
    badge.addEventListener('click', () => {
      const flipped = badge.getAttribute('aria-pressed') === 'true';
      badge.setAttribute('aria-pressed', String(!flipped));

      // На iPhone доступ к наклону даётся только после нажатия.
      if (needsPermission && !asked) {
        asked = true;
        (DeviceOrientationEvent as unknown as OrientationPermission)
          .requestPermission?.()
          .then((state) => state === 'granted' && startGyro())
          .catch(() => {});
      }
    });
  }

  // 3D-бейдж на ленте: грузится, когда страница уже показана, и только там, где он потянет.
  const hero = document.querySelector<HTMLElement>('.heroA');
  const host = document.querySelector<HTMLElement>('[data-lanyard]');
  const card = document.querySelector<HTMLButtonElement>('.badge');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Нужна видеокарта: без неё (программная отрисовка) 3D будет лагать — тогда остаётся обычная карточка.
  const hasGpu = (() => {
    try {
      const gl = document.createElement('canvas').getContext('webgl2');
      if (!gl) return false;
      const info = gl.getExtension('WEBGL_debug_renderer_info');
      const name = info ? String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL)) : '';
      return !/swiftshader|llvmpipe|softpipe|software|basic render/i.test(name);
    } catch {
      return false;
    }
  })();
  // Режим экономии трафика или совсем медленный интернет — не тянем 3D.
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } })
    .connection;
  const thinNetwork = !!connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? '');
  // ?3d в адресе включает бейдж принудительно (для проверки на любом устройстве).
  const forced = new URLSearchParams(location.search).has('3d');

  if (hero && host && card && !reduceMotion && (forced || (hasGpu && !thinNetwork))) {
    const text = (sel: string) => card.querySelector(sel)?.textContent?.trim() ?? '';
    const start = async () => {
      try {
        const { mountLanyard } = await import('../scripts/lanyard');
        const lanyard = await mountLanyard({
          host,
          target: card,
          content: {
            role: text('.badge__role'),
            first: text('.badge__name span:first-child'),
            last: text('.badge__name span:last-child'),
            handle: card.dataset.handle ?? '',
            site: card.dataset.site ?? '',
            qr: card.dataset.qr ?? '',
            qrSize: Number(card.dataset.qrSize ?? 0),
            tag: card.dataset.tag ?? '',
            qrTitle: card.dataset.qrTitle ?? '',
          },
          isFlipped: () => card.getAttribute('aria-pressed') === 'true',
          onTap: () => card.click(),
          onReady: () => {
            hero.classList.add('is-3d');
            const hint = hero.querySelector<HTMLElement>('[data-drag-hint]');
            if (hint?.dataset.dragHint) hint.textContent = hint.dataset.dragHint;
          },
        });
        new MutationObserver(lanyard.wake).observe(card, { attributes: true, attributeFilter: ['aria-pressed'] });
      } catch (error) {
        // Не загрузилось — остаётся обычная карточка.
        hero.classList.remove('is-3d');
        console.warn('3D badge unavailable', error);
      }
    };
    const idle = (fn: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 300);
    if (document.readyState === 'complete') idle(start);
    else window.addEventListener('load', () => idle(start), { once: true });
  }
</script>
