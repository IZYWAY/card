---
// Весь сайт набран тем же шрифтом, что и бейдж: Geist и Geist Mono (лицензия OFL).
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
// Основной шрифт подгружается заранее: иначе текст сначала рисуется запасным шрифтом,
// а потом перескакивает на Geist и сдвигает кнопки.
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistCyrillic from '@fontsource-variable/geist/files/geist-cyrillic-wght-normal.woff2?url';
import { copy, href, asset, type Lang } from '../data/profile';
import LangSwitch from '../components/LangSwitch.astro';

interface Props {
  lang: Lang;
  /** Путь страницы без языка: '', 'a' или 'b'. */
  path?: string;
  title?: string;
}

const { lang, path = '', title } = Astro.props;
const t = copy[lang];
const fullName = `${t.first} ${t.last}`;
const preloadFonts = lang === 'ru' ? [geistCyrillic, geistLatin] : [geistLatin];
const pageTitle = title ? `${title} · ${fullName}` : `${fullName} · ${t.role}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#EDEDED" />
    <title>{pageTitle}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="profile" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    {preloadFonts.map((font) => <link rel="preload" as="font" type="font/woff2" href={font} crossorigin />)}
    <link rel="alternate" hreflang="en" href={href('en', path)} />
    <link rel="alternate" hreflang="ru" href={href('ru', path)} />
  </head>
  <body>
    <header class="top">
      <a class="top__mark wordmark" href={href(lang)} aria-label={fullName}>
        {t.first[0]}{t.last[0]}<span>{t.badgeTag}</span>
      </a>
      <nav class="top__lang mono" aria-label="Language">
        <a href={href('en', path)} aria-current={lang === 'en' ? 'true' : undefined} lang="en">EN</a>
        <span aria-hidden="true">/</span>
        <a href={href('ru', path)} aria-current={lang === 'ru' ? 'true' : undefined} lang="ru">RU</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      document.documentElement.classList.add('js');
      const items = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      items.forEach((item) => observer.observe(item));
    </script>
    <LangSwitch />
  </body>
</html>

<style is:global>
  /* Стиль сайта повторяет бейдж: чёрное и белое, без цветных акцентов,
     шрифт Geist, подписи моноширинным Geist Mono, знак с меткой в рамке. */
  :root {
    --bg: #ededed;
    --paper: #ffffff;
    --ink: #000000;
    --ink-soft: #595959;
    --line: rgba(0, 0, 0, 0.14);
    --on-ink: #ffffff;
    --on-ink-soft: #b3b3b3;
    --display: 'Geist Variable', 'Helvetica Neue', Arial, sans-serif;
    --text: 'Geist Variable', 'Helvetica Neue', Arial, sans-serif;
    --monoface: 'Geist Mono Variable', ui-monospace, monospace;
    --gutter: 20px;
    --radius: 12px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--text);
    font-size: 17px;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .mono {
    font-family: var(--monoface);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Знак, как на бейдже: инициалы и короткая метка в рамке. */
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    font-weight: 600;
    font-size: 17px;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .wordmark span,
  .tagbox {
    display: inline-grid;
    place-items: center;
    min-width: 1.72em;
    height: 1.72em;
    padding: 0 0.32em;
    border: 0.13em solid currentColor;
    border-radius: 0.4em;
    font-weight: 600;
    font-size: 0.5em;
    line-height: 1;
    letter-spacing: 0;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px var(--gutter) 0;
    padding-top: max(16px, env(safe-area-inset-top));
  }

  .top__mark {
    text-decoration: none;
    padding: 8px 0;
  }

  .top__lang {
    display: flex;
    gap: 6px;
    align-items: center;
    color: var(--ink-soft);
  }

  .top__lang a {
    text-decoration: none;
    padding: 8px 4px;
  }

  .top__lang a[aria-current='true'] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }

  .lead {
    margin: 0;
    max-width: 30ch;
    font-weight: 500;
    font-size: clamp(17px, 4.6vw, 20px);
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    width: 100%;
    max-width: 380px;
  }

  .btn {
    flex: 1 1 160px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 18px;
    border-radius: var(--radius);
    border: 1.5px solid var(--ink);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn--primary {
    background: var(--ink);
    color: var(--on-ink);
  }

  @media (hover: hover) {
    .btn:hover {
      background: var(--ink);
      color: var(--on-ink);
    }
    .btn--primary:hover {
      background: var(--bg);
      color: var(--ink);
    }
  }

  .section {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 72px var(--gutter) 0;
  }

  /* Заголовок раздела: слово со «сдвигом» и число в рамке, как метка у знака. */
  .section__title {
    display: flex;
    align-items: flex-start;
    gap: 0.16em;
    margin: 0 0 28px;
    font-family: var(--display);
    font-weight: 640;
    font-size: clamp(34px, 10.5vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .section__title .tagbox {
    flex: none;
    margin-top: 0.3em;
    font-size: 0.26em;
    border-width: 0.11em;
  }

  /* Появление при прокрутке. Без скриптов всё видно сразу. */
  .js .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.6s ease,
      transform 0.7s cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .js .reveal.is-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
